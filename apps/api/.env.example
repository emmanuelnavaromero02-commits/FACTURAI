# Facturia API - Entorno de Configuración

ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Base de datos (REGLA 2: La API corre con el rol no-dueño facturia_app para forzar RLS)
DATABASE_URL=postgresql+asyncpg://facturia_app:facturia_app_secret@localhost:5432/facturia

# Rol dueño para migraciones con Alembic
DATABASE_MIGRATION_URL=postgresql+asyncpg://facturia_owner:facturia_owner_secret@localhost:5432/facturia

# Cola Redis / ARQ
REDIS_URL=redis://localhost:6379/0

# MinIO / S3 (Bucket efímero con TTL de 24h para imágenes)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadminpassword
S3_BUCKET_NAME=facturia-tickets-temp
S3_REGION=us-east-1

# Cifrado de credenciales de portales (REGLA 6: AES-256-GCM derivado por tenant)
# Clave maestra de 32 bytes en base64
MASTER_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=

# Anthropic Claude Modelos (REGLA 11: usar identificadores exactos)
# Documentación oficial de modelos: https://platform.claude.com/docs/en/models/overview
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_VISION=claude-opus-5
ANTHROPIC_MODEL_AGENTE=claude-fable-5-1
ANTHROPIC_MODEL_FALLBACK=claude-sonnet-5

# Precios oficiales de tokens por millón en USD (normalizados en mayúsculas con guiones bajos)
# Tarifas y modelos: https://platform.claude.com/docs/en/models/overview
# Dejar vacíos/comentados si no se configuran; si no están definidos, el sistema reporta "costo no disponible"
# ANTHROPIC_PRECIO_IN_CLAUDE_OPUS_5=
# ANTHROPIC_PRECIO_OUT_CLAUDE_OPUS_5=
# ANTHROPIC_PRECIO_IN_CLAUDE_FABLE_5_1=
# ANTHROPIC_PRECIO_OUT_CLAUDE_FABLE_5_1=
# ANTHROPIC_PRECIO_IN_CLAUDE_SONNET_5=
# ANTHROPIC_PRECIO_OUT_CLAUDE_SONNET_5=

# Límites del Agente Genérico Web (Paso B)
COSTO_MAXIMO_POR_TICKET_USD=0.50
PASOS_MAXIMOS_AGENTE=30

# Handoff Humano Interactivo (Paso C)
HANDOFF_TTL_SEGUNDOS=180
HANDOFF_MAX_CONCURRENTES=5
