# Copia este archivo como .env para ajustar el programa. Todo es opcional en el modo local.
# Las contraseñas y las llaves de la IA no se escriben aquí salvo donde se indica.

# ── Datos y navegador ─────────────────────────────────────────────────────────────────────
# Datos persistentes. Docker usa el volumen /data.
FACTURADOR_DATA=./data
# Ruta a Chromium si lo instalaste fuera de Playwright. En Docker se configura sola.
FACTURADOR_CHROMIUM_PATH=
# Con 1 el navegador se abre con ventana (Docker lo usa con Google Chrome y Xvfb). Vacío: sin ventana.
FACTURADOR_CHROME_HEADED=
# Lo fija el Dockerfile (1 dentro del contenedor, para escuchar en 0.0.0.0). No lo pongas en .env:
# el programa lo lee antes de cargar este archivo.
# FACTURADOR_CONTAINER=1

# ── Motor ─────────────────────────────────────────────────────────────────────────────────
# Con 0 no se repiten las pantallas ya resueltas de la memoria de portales (lo resuelto se sigue
# aprendiendo). Vacío o cualquier otro valor: la memoria se usa.
FACTURADOR_MEMORIA=
# Con 0 todos los comercios, también los que tienen complemento propio, van por el motor general.
FACTURADOR_COMPLEMENTOS=

# ── IA de pago por uso ────────────────────────────────────────────────────────────────────
# Llaves de API. Si las fijas aquí mandan sobre las que se escriben en Ajustes, que ya no se
# pueden cambiar desde el panel. Sin ellas se usa el plan de ChatGPT o la llave escrita en Ajustes.
FACTURAI_OPENAI_API_KEY=
FACTURAI_ANTHROPIC_API_KEY=

# ── Avisos ────────────────────────────────────────────────────────────────────────────────
# Contacto que se manda a los servicios de avisos del navegador: mailto:alguien@ejemplo.com o una
# dirección https://. Vacío: se usa uno genérico.
FACTURADOR_AVISOS_CONTACTO=
# Servidores de avisos extra, separados por coma (además de los de Google, Mozilla, Apple y Microsoft).
FACTURADOR_PUSH_HOSTS=

# ── Llave maestra ─────────────────────────────────────────────────────────────────────────
# Opcional en el modo local y obligatoria con varios usuarios. Con ella se guardan cifradas las
# llaves de las contraseñas de portales y del correo, las de la IA, la llave privada de los avisos
# y las conexiones de ChatGPT y Gmail.
# Lo que ya estaba guardado sin cifrar se cifra solo la primera vez que se lee.
# Debe estar FUERA de la carpeta de datos. Guarda una copia en otro lugar seguro: si falta o es
# otra, el programa no arranca y nada de lo guardado se toca.
# Para crearla:  python -m facturador crear-llave ../facturai-llave/llave-maestra.key
FACTURADOR_ARCHIVO_LLAVE=
# Otra forma: la llave misma (32 bytes en base64). Usa solo una de las dos.
FACTURADOR_LLAVE_MAESTRA=

# ── Varios usuarios (apagado por omisión) ─────────────────────────────────────────────────
# local: lo de siempre. Una persona, sin cuentas, panel solo en 127.0.0.1.
# usuarios: se entra con usuario y contraseña y cada cliente tiene sus datos aparte. Va detrás
# de un proxy con TLS (ver compose.yaml y docker/Caddyfile.ejemplo) y exige la llave maestra.
FACTURADOR_MODO=local
# Dirección https por la que se entra desde fuera, sin ruta. Ejemplo: https://facturas.ejemplo.com
# Sin ella el modo de usuarios no arranca. Solo para pruebas se admite http://localhost:8765
FACTURADOR_ORIGEN_PUBLICO=
# Direcciones o redes del proxy. Solo de ellas se acepta la dirección real de quien entra, que se
# usa para frenar los intentos de adivinar contraseñas.
FACTURADOR_PROXIES=127.0.0.1
# Navegadores abiertos a la vez entre todos los clientes (de 1 a 50). El ticket que no alcanza espera su turno.
FACTURADOR_NAVEGADORES_MAX=3
# Minutos sin uso (de 1 a 1440) para cerrar el espacio de un cliente que no tiene trámites ni tareas pendientes.
FACTURADOR_INSTANCIA_INACTIVA_MIN=30
# El primer administrador se crea en la terminal:  python -m facturador crear-admin
# Su contraseña se escribe con el teclado; no existe una variable para ella.
