# Datos persistentes. Docker usa el volumen /data.
FACTURADOR_DATA=./data
# Ruta a Chromium si lo instalaste fuera de Playwright. En Docker se configura sola.
FACTURADOR_CHROMIUM_PATH=

# ── Llave maestra ─────────────────────────────────────────────────────────────────────────
# Opcional en el modo local y obligatoria con varios usuarios. Con ella se guardan cifradas las
# llaves de las contraseñas de portales y del correo, y las conexiones de ChatGPT y Gmail.
# Lo que ya estaba guardado sin cifrar se cifra solo la primera vez que se lee.
# Debe estar FUERA de la carpeta de datos. Guarda una copia en otro lugar seguro: si falta o es
# otra, el programa no arranca y nada de lo guardado se toca.
# Para crearla:  python -m facturador crear-llave ../facturai-llave/llave-maestra.key
FACTURADOR_ARCHIVO_LLAVE=
# Otra forma: la llave misma (32 bytes en base64). Usa solo una de las dos.
FACTURADOR_LLAVE_MAESTRA=

# ── Varios usuarios (apagado por omisión) ─────────────────────────────────────────────────
# local: lo de siempre. Una persona, sin cuentas, panel solo en 127.0.0.1.
# usuarios: se entra con usuario y contraseña y cada cliente tiene sus datos aparte. Va detrás
# de un proxy con TLS (ver compose.yaml y docker/Caddyfile.ejemplo) y exige la llave maestra.
FACTURADOR_MODO=local
# Dirección https por la que se entra desde fuera, sin ruta. Ejemplo: https://facturas.ejemplo.com
# Sin ella el modo de usuarios no arranca. Solo para pruebas se admite http://localhost:8765
FACTURADOR_ORIGEN_PUBLICO=
# Direcciones o redes del proxy. Solo de ellas se acepta la dirección real de quien entra, que se
# usa para frenar los intentos de adivinar contraseñas.
FACTURADOR_PROXIES=127.0.0.1
# Navegadores abiertos a la vez entre todos los clientes. El ticket que no alcanza espera su turno.
FACTURADOR_NAVEGADORES_MAX=3
# Minutos sin uso para cerrar el espacio de un cliente que no tiene trámites ni tareas pendientes.
FACTURADOR_INSTANCIA_INACTIVA_MIN=30
# El primer administrador se crea en la terminal:  python -m facturador crear-admin
